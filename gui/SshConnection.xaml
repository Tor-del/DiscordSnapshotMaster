<Window x:Class="DiscordSnapshot.Gui.SshConnection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UiOpenSshProject}" Icon="Assets/App.ico" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Language="{DynamicResource UiCulture}" FontFamily="Segoe UI Variable, Segoe UI"
        Background="#20242B" Foreground="#F5F5F5" FocusManager.FocusedElement="{Binding ElementName=HostName}">
    <StackPanel Margin="24">
        <TextBlock Text="{DynamicResource UiOpenSshProject}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="{DynamicResource UiSshInstructions}" TextWrapping="Wrap" Foreground="#C2C8D0" Margin="0,0,0,14" />
        <TextBlock Text="{DynamicResource UiSshHost}" />
        <TextBox x:Name="HostName" Style="{StaticResource DialogInput}" Margin="0,4,0,10"
                 AutomationProperties.Name="{DynamicResource UiSshHost}" />
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{DynamicResource UiSshUser}" />
                <TextBox x:Name="UserName" Style="{StaticResource DialogInput}" Margin="0,4,0,0"
                         AutomationProperties.Name="{DynamicResource UiSshUser}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{DynamicResource UiSshPort}" />
                <TextBox x:Name="Port" Text="22" MaxLength="5" Style="{StaticResource DialogInput}" Margin="0,4,0,0"
                         AutomationProperties.Name="{DynamicResource UiSshPort}" />
            </StackPanel>
        </Grid>
        <TextBlock Text="{DynamicResource UiSshPath}" />
        <TextBox x:Name="RemoteDirectory" Style="{StaticResource DialogInput}" Margin="0,4,0,10"
                 AutomationProperties.Name="{DynamicResource UiSshPath}" />
        <TextBlock Text="{DynamicResource UiNewSshProjectName}" />
        <TextBox x:Name="NameInput" MaxLength="120" Style="{StaticResource DialogInput}" Margin="0,4,0,8"
                 AutomationProperties.Name="{DynamicResource UiNewSshProjectName}" />
        <TextBlock x:Name="ErrorText" Foreground="#FFB4AB" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource UiCancelCopy}" IsCancel="True" Padding="14,6" />
            <Button Content="{DynamicResource UiOpenSshProject}" IsDefault="True" Click="ConnectClick" Padding="14,6"
                    Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
