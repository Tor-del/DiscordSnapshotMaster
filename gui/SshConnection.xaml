<Window x:Class="DiscordSnapshot.Gui.SshConnection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UiOpenSshProject}" Icon="Assets/App.ico" Width="510" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Language="{DynamicResource UiCulture}" FontFamily="Segoe UI Variable, Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="{DynamicResource UiSshInstructions}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Text="{DynamicResource UiSshHost}" />
        <TextBox x:Name="HostName" Margin="0,3,0,8" AutomationProperties.Name="{DynamicResource UiSshHost}" />
        <TextBlock Text="{DynamicResource UiSshUser}" />
        <TextBox x:Name="UserName" Margin="0,3,0,8" AutomationProperties.Name="{DynamicResource UiSshUser}" />
        <TextBlock Text="{DynamicResource UiSshPort}" />
        <TextBox x:Name="Port" Text="22" MaxLength="5" Margin="0,3,0,8" AutomationProperties.Name="{DynamicResource UiSshPort}" />
        <TextBlock Text="{DynamicResource UiSshPath}" />
        <TextBox x:Name="RemoteDirectory" Margin="0,3,0,8" AutomationProperties.Name="{DynamicResource UiSshPath}" />
        <TextBlock x:Name="ErrorText" Foreground="#FFB4AB" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource UiCancelCopy}" IsCancel="True" Padding="14,6" />
            <Button Content="{DynamicResource UiOpenSshProject}" IsDefault="True" Click="ConnectClick" Padding="14,6"
                    Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
