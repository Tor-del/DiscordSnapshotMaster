<Window x:Class="DiscordSnapshot.Gui.AuthorizationSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UiAuthorizationSettings}" Icon="Assets/App.ico" Width="760" Height="740"
        MinWidth="580" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Language="{DynamicResource UiCulture}" FontFamily="Segoe UI Variable, Segoe UI"
        Background="#20242B" Foreground="#F5F5F5">
    <Window.Resources>
        <SolidColorBrush x:Key="Secondary" Color="#BDBDBD" />
        <Style x:Key="AuthorizationField" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Secondary}" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="24,16,24,18">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource UiAuthorizationSettings}"
                   FontSize="28" FontWeight="SemiBold" Margin="0,2,0,16" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#FFB4AB" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                <Button Content="{DynamicResource UiCancelCopy}" IsCancel="True" Padding="16,6" MinHeight="34" />
                <Button Content="{DynamicResource UiSaveAuthorization}" IsDefault="True" Click="SaveClick" Padding="16,6"
                        Margin="8,0,0,0" MinHeight="34" Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
        <Border Background="#252525" BorderBrush="#454545" BorderThickness="1" CornerRadius="8" Padding="8">
        <TabControl BorderThickness="0" Background="Transparent" Padding="0">
            <TabItem Header="{DynamicResource UiOAuthSettings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="{DynamicResource UiOAuthRedirectSteps}" Style="{StaticResource AuthorizationField}"
                                   TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,8" />
                        <TextBlock Margin="0,0,0,12">
                            <Hyperlink Click="OpenDiscordPortal" Foreground="#60CDFF">Discord Developer Portal</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="Client ID" Style="{StaticResource AuthorizationField}" />
                        <TextBox x:Name="ClientId" AutomationProperties.Name="Client ID" MaxLength="20" Margin="0,4,0,12"
                                 Style="{StaticResource DialogInput}" />
                        <TextBlock Text="Client Secret" Style="{StaticResource AuthorizationField}" />
                        <PasswordBox x:Name="ClientSecret" AutomationProperties.Name="Client Secret" MaxLength="256" Margin="0,4,0,12"
                                     Style="{StaticResource DialogInput}" />
                        <TextBlock Text="Discord Redirect URI" Style="{StaticResource AuthorizationField}" />
                        <TextBox x:Name="RedirectUri" AutomationProperties.Name="Discord Redirect URI" MaxLength="1024" Margin="0,4,0,0"
                                 Style="{StaticResource DialogInput}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource UiAuthorizationUsers}">
                <DockPanel Margin="14">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button x:Name="AddUserButton" DockPanel.Dock="Right" Click="AddUserClick"
                                Content="{DynamicResource UiAddArchiveUser}" MinHeight="34" Padding="12,4" Margin="12,0,0,0" />
                        <TextBlock Text="{DynamicResource UiAuthorizationUsersHint}" Style="{StaticResource AuthorizationField}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="Users" AutomationProperties.Name="{DynamicResource UiAuthorizationUsers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2C2C2C" BorderBrush="#454545" BorderThickness="1"
                                                CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="UserIdInput" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Discord ID" ToolTip="Discord ID" MaxLength="20"
                                                         Style="{StaticResource DialogInput}" />
                                                <CheckBox Grid.Column="1" IsChecked="{Binding Admin}" VerticalAlignment="Center"
                                                          Margin="12,0" Content="{DynamicResource UiArchiveAdmin}" />
                                                <Button Grid.Column="2" Click="RemoveUserClick" MinHeight="34" Padding="8,4"
                                                        Content="{DynamicResource UiRemoveArchiveUser}"
                                                        AutomationProperties.HelpText="{Binding Id}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{DynamicResource UiNoArchiveUsers}" Foreground="{StaticResource Secondary}"
                                   Margin="2,6" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=Users}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{DynamicResource UiAuthorizationGuilds}">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource UiAuthorizationGuildsHint}" Style="{StaticResource AuthorizationField}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBox x:Name="Guilds" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch"
                             Style="{StaticResource DialogInput}"
                             AutomationProperties.Name="{DynamicResource UiAuthorizationGuilds}" />
                </DockPanel>
            </TabItem>
        </TabControl>
        </Border>
    </DockPanel>
</Window>
