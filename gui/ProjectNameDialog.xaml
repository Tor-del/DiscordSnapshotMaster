<Window x:Class="DiscordSnapshot.Gui.ProjectNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/App.ico" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Language="{DynamicResource UiCulture}" FontFamily="Segoe UI Variable, Segoe UI"
        Background="#20242B" Foreground="#F5F5F5">
    <StackPanel Margin="24">
        <TextBlock Text="{DynamicResource UiProjectName}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBox x:Name="NameInput" MaxLength="120" Style="{StaticResource DialogInput}"
                 AutomationProperties.Name="{DynamicResource UiProjectName}" />
        <TextBlock x:Name="ErrorText" Foreground="#FFB4AB" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource UiCancelCopy}" IsCancel="True" Padding="14,6" />
            <Button Content="{DynamicResource UiSaveProjectName}" IsDefault="True" Click="SaveClick"
                    Padding="14,6" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
