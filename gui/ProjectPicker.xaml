<Window x:Class="DiscordSnapshot.Gui.ProjectPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DiscordSnapshot;assembly=DiscordSnapshot.Core"
        Title="{x:Static core:Strings.ProductName}" Icon="Assets/App.ico" Width="620" Height="460" MinWidth="460" MinHeight="340"
        WindowStartupLocation="CenterScreen" Language="{DynamicResource UiCulture}" FontFamily="Segoe UI Variable, Segoe UI"
        Background="#20242B" Foreground="#F5F5F5">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource UiArchiveHeading}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,18" />
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="ClearHistoryButton" DockPanel.Dock="Right" Content="{DynamicResource UiClearHistory}"
                    Click="ClearHistoryClick" />
            <TextBlock Text="{DynamicResource UiRecentProjects}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <Border Grid.Row="2" Background="#252525" BorderBrush="#454545" BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
                <TextBlock x:Name="EmptyText" Text="{DynamicResource UiNoRecentProjects}" Foreground="#BDBDBD" Margin="8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RecentProjects">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Click="RemoveRecentClick" Width="32" Margin="6,0,0,0" Padding="0"
                                            ToolTip="{DynamicResource UiRemoveRecentProject}"
                                            AutomationProperties.Name="{DynamicResource UiRemoveRecentProject}"
                                            AutomationProperties.HelpText="{Binding Label}">
                                        <Path Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,1 L 9,9 M 9,1 L 1,9" />
                                    </Button>
                                    <Button Click="RecentClick" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                            HorizontalContentAlignment="Left" Padding="8,6">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFB4AB" AutomationProperties.LiveSetting="Polite" />
            <DockPanel Margin="0,6,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="{DynamicResource UiOpenProject}" Click="PickFolder"
                        IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Padding="18,6" MinHeight="34" />
                <Button DockPanel.Dock="Right" Content="{DynamicResource UiOpenSshShort}" Click="PickSsh"
                        Padding="12,6" Margin="0,0,8,0" MinHeight="34" />
                <TextBlock Text="{DynamicResource UiLanguage}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="LanguagePicker" AutomationProperties.Name="{DynamicResource UiLanguage}"
                          SelectionChanged="LanguageChanged" SelectedValuePath="Tag" MinWidth="105">
                    <ComboBoxItem Tag="en" Content="English" />
                    <ComboBoxItem Tag="ru" Content="Русский" />
                </ComboBox>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
