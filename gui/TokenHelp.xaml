<Window x:Class="DiscordSnapshot.Gui.TokenHelp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UiTokenHelp}" Width="570" Height="510" MinWidth="380" MinHeight="310"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Language="{DynamicResource UiCulture}" FontFamily="Segoe UI Variable, Segoe UI"
        Background="#20242B" Foreground="#F5F5F5">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource UiTokenHelp}" FontSize="24" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,14" />
        <Button DockPanel.Dock="Bottom" Content="{DynamicResource UiCloseHelp}" IsCancel="True" IsDefault="True"
                HorizontalAlignment="Right" Padding="18,6" Margin="0,14,0,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="LineHeight" Value="21" />
                        <Setter Property="Margin" Value="0,0,0,12" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock>
                    <Hyperlink Click="OpenPortalClick" Foreground="#60CDFF"><Run Text="Discord Developer Portal" /></Hyperlink>
                </TextBlock>
                <TextBlock Text="{DynamicResource UiTokenStepApplication}" />
                <TextBlock Text="{DynamicResource UiTokenStepReset}" />
                <TextBlock Text="{DynamicResource UiTokenStepIntent}" />
                <TextBlock Text="{DynamicResource UiTokenStepInstall}" />
                <TextBlock Text="{DynamicResource UiTokenStepConnect}" />
                <TextBlock Text="{DynamicResource UiTokenPrivate}" Foreground="#BDBDBD" Margin="0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
