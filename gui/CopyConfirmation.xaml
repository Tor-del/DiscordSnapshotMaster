<Window x:Class="DiscordSnapshot.Gui.CopyConfirmation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiscordSnapshot.Gui"
        Title="{DynamicResource UiConfirmCopy}" Width="560" Height="420" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Language="{DynamicResource UiCulture}" FontFamily="Segoe UI Variable, Segoe UI"
        Background="#20242B" Foreground="#F5F5F5">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource UiConfirmCopy}" FontSize="23" FontWeight="SemiBold" />
            <TextBlock x:Name="SelectionSummary" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource UiCancelCopy}" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
            <Button Content="{DynamicResource UiConfirmStart}" IsDefault="True" Click="ConfirmClick"
                    Style="{DynamicResource AccentButtonStyle}" Padding="16,6" />
        </StackPanel>
        <ListBox x:Name="SelectedChannels" AutomationProperties.Name="{DynamicResource UiArchiveChannels}"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,4">
                        <local:ChannelTitle Title="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="#BDBDBD">
                            <Run Text="{Binding Action, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Id, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
